load("@rules_go//extras:gomock.bzl", "gomock")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dotbazel",
    srcs = [
        "filenames.go",
        "parse_module.go",
        "parse_repo.go",
    ],
    importpath = "bonanza.build/pkg/dotbazel",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/label",
        "//pkg/starlark/compile",
        "//pkg/starlark/eval",
        "//pkg/starlark/resolve",
        "//pkg/starlark/syntax",
        "//pkg/starlark/unpack",
        "@com_github_buildbarn_bb_storage//pkg/filesystem/path",
        "@com_github_buildbarn_bb_storage//pkg/util",
    ],
)

go_test(
    name = "dotbazel_test",
    srcs = [
        "mocks_dotbazel_test.go",
        "parse_module_test.go",
        "parse_repo_test.go",
    ],
    embed = [":dotbazel"],
    deps = [
        "//pkg/label",
        "//pkg/starlark/eval",
        "@com_github_buildbarn_bb_storage//pkg/filesystem/path",
        "@com_github_buildbarn_bb_storage//pkg/util",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_mock//gomock",
    ],
)

gomock(
    name = "mocks_dotbazel",
    out = "mocks_dotbazel_test.go",
    interfaces = [
        "RootHandler",
        "ModuleExtensionProxy",
        "RepoRuleProxy",
    ],
    library = "//pkg/dotbazel",
    mockgen_model_library = "@org_uber_go_mock//mockgen/model",
    mockgen_tool = "@org_uber_go_mock//mockgen",
    package = "dotbazel_test",
)
